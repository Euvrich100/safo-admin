# ==============================
# SafO Admin — Variables de entorno
# Copia este archivo como .env.local y completa los valores
# ==============================

# URL del backend
NEXT_PUBLIC_API_URL=http://localhost:3000

# Login con Google — el mismo Client ID que configuraste en el backend
# (debe ser exactamente el mismo GOOGLE_CLIENT_ID de safo-backend/.env)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
